{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"share": "disabled",
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://host.docker.internal:1234/v1",
				"timeout": 2400000,
				"stream": true
			},
			"models": {
				"qwen/qwen3-coder-30b": {
					"name": "Qwen3 30B Coder",
					"reasoning": true
				},
				"openai/gpt-oss-20b": {
					"name": "GPT OSS 20B",
					"reasoning": true
				}
			}
		},
		"deepseek": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "DeepSeek",
			"options": {
				"baseURL": "https://api.deepseek.com",
				"apiKey": "{env:DEEPSEEK_API_KEY}"
			},
			"models": {
				"deepseek-chat": {
					"name": "DeepSeek Chat"
				},
				"deepseek-reasoner": {
					"name": "DeepSeek Reasoner (V3.2-Exp)"
				}
			}
		}
	},
	"model": "lmstudio/qwen/qwen3-coder-30b",
	// "small_model": "lmstudio/openai/gpt-oss-20b",
	"agent": {
		"orchestrator": {
			"enabled": true,
			"mode": "primary",
			"description": "Координирует выполнение задач, делегирует работу специализированным агентам, проверяет результаты и обеспечивает согласованность между этапами разработки",
			"prompt": "~/.config/opencode/agent/orchestrator.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.3,
			"tools": {
				"*": true,
				"edit": true,
				"read": true,
				"list": true,
				"grep": true,
				"bash": true
			},
			"permission": {
				"edit": "ask",
				"bash": {
					"*": "ask",
					"git status": "allow",
					"git diff": "allow",
					"git log": "allow"
				}
			},
			"subagents": {
				"project-analyst": true,
				"test-engineer": true,
				"go-developer": true,
				"code-reviewer": true,
				"technical-writer": true
			}
		},
		"project-analyst": {
			"enabled": true,
			"mode": "subagent",
			"description": "Анализирует требования проекта, составляет и обновляет Product Requirements Document (PRD), создает планы разработки фич",
			"prompt": "~/.config/opencode/agent/project-analyst.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.4,
			"tools": {
				"read": true,
				"list": true,
				"grep": true,
				"edit": true,
				"bash": false
			},
			"permission": {
				"edit": "allow",
				"bash": "deny"
			}
		},
		"test-engineer": {
			"enabled": true,
			"mode": "subagent",
			"description": "Разрабатывает unit-тесты и интеграционные тесты для Go-кода, использует TestContainers для сложных сценариев, обеспечивает покрытие кода тестами",
			"prompt": "~/.config/opencode/agent/test-engineer.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.2,
			"tools": {
				"read": true,
				"list": true,
				"grep": true,
				"edit": true,
				"bash": true
			},
			"permission": {
				"edit": "allow",
				"bash": {
					"*": "ask",
					"go test": "allow",
					"go test *": "allow",
					"go mod *": "allow"
				}
			}
		},
		"go-developer": {
			"enabled": true,
			"mode": "subagent",
			"description": "Пишет production-ready Go код для микросервисов, работает с Kubernetes, Redis, PostgreSQL, Kafka, следует best practices Go разработки",
			"prompt": "~/.config/opencode/agent/go-developer.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.2,
			"tools": {
				"read": true,
				"list": true,
				"grep": true,
				"edit": true,
				"bash": true
			},
			"permission": {
				"edit": "allow",
				"bash": {
					"*": "ask",
					"go build": "allow",
					"go mod *": "allow",
					"go fmt": "allow",
					"gofmt *": "allow",
					"golangci-lint *": "allow"
				}
			}
		},
		"code-reviewer": {
			"enabled": true,
			"mode": "subagent",
			"description": "Проверяет корректность кода, соблюдение стандартов Go, выявляет потенциальные баги, проверяет безопасность и производительность, предлагает улучшения",
			"prompt": "~/.config/opencode/agent/code-reviewer.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.1,
			"tools": {
				"read": true,
				"list": true,
				"grep": true,
				"edit": false,
				"bash": true
			},
			"permission": {
				"edit": "deny",
				"bash": {
					"*": "ask",
					"golangci-lint *": "allow",
					"go vet": "allow",
					"staticcheck *": "allow"
				}
			}
		},
		"technical-writer": {
			"enabled": true,
			"mode": "subagent",
			"description": "Создает и актуализирует техническую документацию, API документацию, README файлы, комментарии к коду, описания архитектуры",
			"prompt": "~/.config/opencode/agent/technical-writer.md",
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"temperature": 0.3,
			"tools": {
				"read": true,
				"list": true,
				"grep": true,
				"edit": true,
				"bash": false
			},
			"permission": {
				"edit": "allow",
				"bash": "deny"
			}
		}
	},
	"permission": {
		"edit": "ask",
		"bash": "ask",
		"webfetch": "allow"
	},
	"mcp": {
		"context7": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@upstash/context7-mcp"
			],
			"enabled": true
		},
		"perplexity": {
			"type": "local",
			"enabled": true,
			"command": [
				"npx",
				"-y",
				"@perplexity-ai/mcp-server"
			],
			"environment": {
				"PERPLEXITY_API_KEY": "env:PERPLEXITY_API_KEY",
				"PERPLEXITY_TIMEOUT_MS": "600000"
			}
		}
	}
}