{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"share": "disabled",
	"model": "z.ai/glm-4.7",
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://host.docker.internal:1234/v1",
				"timeout": 2400000,
				"stream": true
			},
			"models": {
				"openai/gpt-oss-20b": {},
				"mistralai/devstral-small-2-2512": {}
			}
		},
		"z.ai": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://api.z.ai/api/coding/paas/v4",
				"apiKey": "{env:ZAI_API_KEY}"
			},
			"models": {
				"glm-4.7": {
					"name": "glm-4.7",
				},
				"glm-4.5": {
					"name": "glm-4.5"
				}
			}
		},
		"moonshot": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://api.moonshot.ai/v1",
				"apiKey": "{env:MOONSHOT_API_KEY}"
			},
			"models": {
				"kimi-k2-thinking": {
					"name": "Kimi K2 Thinking"
				}
			}
		},
		"deepseek": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "https://api.deepseek.com",
				"apiKey": "{env:DEEPSEEK_API_KEY}"
			},
			"models": {
				"deepseek-chat": {
					"name": "DeepSeek Chat"
				},
				"deepseek-reasoner": {
					"name": "DeepSeek Reasoner (V3.2-Exp)"
				}
			}
		}
	},
	"tools": {
		"perplexity_perplexity_search": false,
		"perplexity_perplexity_ask": true,
		"perplexity_perplexity_research": false,
		"perplexity_perplexity_reason": false
	},
	"mcp": {
		"context7": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@upstash/context7-mcp"
			],
			"enabled": true
		},
		"playwright": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@playwright/mcp@latest"
			],
			"enabled": true
		},
		"perplexity": {
			"type": "local",
			"enabled": true,
			"command": [
				"npx",
				"-y",
				"@perplexity-ai/mcp-server"
			],
			"environment": {
				"PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}",
				"PERPLEXITY_TIMEOUT_MS": "600000"
			}
		}
	}
}