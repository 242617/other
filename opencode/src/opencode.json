{
	"$schema": "https://opencode.ai/config.json",
	"autoupdate": false,
	"share": "disabled",
	"provider": {
		"lmstudio": {
			"npm": "@ai-sdk/openai-compatible",
			"options": {
				"baseURL": "http://host.docker.internal:1234/v1",
				"timeout": 2400000,
				"stream": true
			}
		},
		"deepseek": {
			"npm": "@ai-sdk/openai-compatible",
			"name": "DeepSeek",
			"options": {
				"baseURL": "https://api.deepseek.com",
				"apiKey": "{env:DEEPSEEK_API_KEY}"
			},
			"models": {
				"deepseek-chat": {
					"name": "DeepSeek Chat"
				},
				"deepseek-reasoner": {
					"name": "DeepSeek Reasoner (V3.2-Exp)"
				}
			}
		}
	},
	// "model": "lmstudio/qwen/qwen3-coder-30b",
	// "small_model": "lmstudio/openai/gpt-oss-20b",
	"agent": {},
	"mode": {
		"analyze": {
			"model": "lmstudio/qwen/qwen3-coder-30b",
			"prompt": "{file:~/.config/opencode/mode/analyse.md}",
			"tools": {
				"context7": true
			}
		}
	},
	"mcp": {
		"context7": {
			"type": "local",
			"command": [
				"npx",
				"-y",
				"@upstash/context7-mcp"
			],
			"enabled": true
		},
		"perplexity": {
			"type": "local",
			"enabled": false,
			"command": [
				"npx",
				"-y",
				"@perplexity-ai/mcp-server"
			],
			"environment": {
				"PERPLEXITY_API_KEY": "{env:PERPLEXITY_API_KEY}",
				"PERPLEXITY_TIMEOUT_MS": "600000"
			}
		}
	}
}